# ==========================================
# RahmoraAI / CVCraft AI Environment Configuration
# ==========================================

# ------------------------------------------
# 1. AI ENGINES & API KEYS
# ------------------------------------------
# GEMINI_API_KEY: Primary flagship Google Gemini AI key (Get free at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# GROQ / RAHMORA AI API KEY: Secondary high-speed quota failover provider (Optional, https://console.groq.com)
GROQ_API_KEY=
RAHMORA_API_KEY=

# ------------------------------------------
# 2. SERVER & DEPLOYMENT CONFIGURATION
# ------------------------------------------
# APP_URL: Base URL where this application is hosted (e.g., https://your-app.vercel.app or http://localhost:3000)
APP_URL="http://localhost:3000"
NODE_ENV="production"
# ALLOWED_ORIGINS: Optional comma-separated list of additional trusted CORS origins
ALLOWED_ORIGINS=

# ------------------------------------------
# 3. ADMINISTRATOR & SECURITY CONTROLS
# ------------------------------------------
# Administrator email address for admin dashboard authorization
ADMIN_EMAIL=
# Dedicated admin API key for server diagnostic endpoints and API automation
ADMIN_API_KEY=
# Set to 'true' only in local development to display demo verification codes when SMTP is not configured
ALLOW_DEMO_CODE=false
# Set to 'true' only in local development to test mock payment orders when PayPal credentials are unset
ALLOW_MOCK_PAYMENTS=false

# ------------------------------------------
# 4. EMAIL & VERIFICATION SERVICE (SMTP)
# ------------------------------------------
# Configure SMTP credentials to deliver 6-digit email verification codes & support notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RahmoraAI Security <noreply@yourdomain.com>"
FEEDBACK_TO_EMAIL=

# ------------------------------------------
# 5. SECURE PAYMENTS (PAYPAL CLIENTS)
# ------------------------------------------
# Server-side PayPal credentials (never exposed to browser clients)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox # Use 'live' for real payments

# ------------------------------------------
# 6. OPTIONAL CLIENT INTEGRATIONS
# ------------------------------------------
ADSENSE_PUBLISHER_ID=

# LINKEDIN OAUTH 2.0 (SIGN IN WITH LINKEDIN)
# Create an app at https://www.linkedin.com/developers/apps
# Add Authorized Redirect URL: https://your-domain.com/auth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ------------------------------------------
# 7. FIREBASE OVERRIDES (OPTIONAL)
# ------------------------------------------
# By default, client config is read from firebase-applet-config.json.
# You can override with your own Firebase project credentials below:
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
