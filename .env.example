# GEMINI_API_KEY: Primary Gemini AI API key.
# Users configure this via the Secrets panel in AI Studio or hosting environment.
GEMINI_API_KEY=

# GROQ / RAHMORA AI API KEY: High-speed secondary provider & quota failover key.
# Users configure this via the Secrets panel in AI Studio or hosting environment.
GROQ_API_KEY=
RAHMORA_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SECURE PAYMENTS CONFIGURATION (PAYPAL CLIENTS)
# Kept securely on the server; never exposed to the frontend browser client.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox # Use 'live' for real production funds
ADSENSE_PUBLISHER_ID=

# FEEDBACK SMTP EMAIL NOTIFICATION SERVICE
# Define these in your Secrets tab to automatically send feedback directly to mwana1601@gmail.com
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

