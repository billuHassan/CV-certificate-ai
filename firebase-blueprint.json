{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account registration and preferences",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's verified registration email"
        },
        "displayName": {
          "type": "string",
          "description": "The user's display name"
        },
        "isPremium": {
          "type": "boolean",
          "description": "Whether the user has complimentary premium access"
        },
        "creationsCount": {
          "type": "integer",
          "description": "Total number of resumes/letters created"
        },
        "adViews": {
          "type": "integer",
          "description": "Counter for system ads viewed"
        },
        "profilePhoto": {
          "type": "string",
          "description": "The image url of the profile picture to avoid storage size costs"
        },
        "settings": {
          "type": "object",
          "description": "Personalized user settings including theme, font, language, region, and notification preferences"
        }
      },
      "required": ["email", "displayName", "isPremium"]
    },
    "Resume": {
      "title": "Resume Data",
      "description": "A comprehensive professional resume document",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "personalInfo": { "type": "object" },
        "summary": { "type": "string" },
        "experience": { "type": "array" },
        "education": { "type": "array" },
        "projects": { "type": "array" },
        "skills": { "type": "array" },
        "languages": { "type": "array" },
        "certifications": { "type": "array" },
        "references": { "type": "array" },
        "sectionsOrder": { "type": "array" },
        "templateId": { "type": "string" },
        "colorTheme": { "type": "string" },
        "fontFamily": { "type": "string" },
        "spacing": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "personalInfo", "updatedAt"]
    },
    "CoverLetter": {
      "title": "Cover Letter Data",
      "description": "A tailored cover letter document matched to a job target",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "recipientName": { "type": "string" },
        "recipientCompany": { "type": "string" },
        "recipientAddress": { "type": "string" },
        "jobTitle": { "type": "string" },
        "jobDescription": { "type": "string" },
        "content": { "type": "string" },
        "date": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "senderInfo": { "type": "object" }
      },
      "required": ["id", "title", "recipientName", "recipientCompany", "content", "date", "senderInfo"]
    },
    "CareerRecommendation": {
      "title": "Career Recommendation Report",
      "description": "An AI-generated analysis matching the user's resume with career roles and companies",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "resumeId": { "type": "string" },
        "resumeTitle": { "type": "string" },
        "overallFitSummary": { "type": "string" },
        "recommendedRoles": { "type": "array" },
        "recommendedCompanies": { "type": "array" },
        "careerStrategy": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "resumeId", "resumeTitle", "overallFitSummary", "recommendedRoles", "recommendedCompanies", "careerStrategy", "createdAt"]
    },
    "Review": {
      "title": "Review Feedback",
      "description": "Feedback and rating submitted by a user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "rating": { "type": "integer" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "userEmail", "userName", "rating", "comment", "createdAt"]
    },
    "AdminChat": {
      "title": "Admin Chat Message",
      "description": "Chat message exchanged between a user and the admin",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The normal user's UID involved in this conversation" },
        "senderId": { "type": "string", "description": "The UID of the person who sent this specific message" },
        "senderEmail": { "type": "string" },
        "senderName": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string" },
        "read": { "type": "boolean" }
      },
      "required": ["userId", "senderId", "senderEmail", "senderName", "message", "createdAt"]
    },
    "DirectMessage": {
      "title": "User to User Direct Message",
      "description": "Chat message exchanged between two users",
      "type": "object",
      "properties": {
        "chatId": { "type": "string", "description": "The composite ID of the two users involved" },
        "senderId": { "type": "string" },
        "senderEmail": { "type": "string" },
        "senderName": { "type": "string" },
        "recipientId": { "type": "string" },
        "recipientEmail": { "type": "string" },
        "recipientName": { "type": "string" },
        "message": { "type": "string" },
        "mediaUrl": { "type": "string" },
        "mediaType": { "type": "string" },
        "createdAt": { "type": "string" },
        "read": { "type": "boolean" }
      },
      "required": ["chatId", "senderId", "senderEmail", "senderName", "recipientId", "recipientEmail", "recipientName", "message", "createdAt", "read"]
    },
    "GameScore": {
      "title": "Game Leaderboard Score",
      "description": "A verified game completion record for leaderboard rankings and timer records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "gameType": { "type": "string", "enum": ["sudoku", "word_matrix", "math_crunch", "coding_quiz", "daily_wordle"] },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "profilePhoto": { "type": "string" },
        "timeSeconds": { "type": "integer" },
        "score": { "type": "integer" },
        "level": { "type": "integer" },
        "dayDate": { "type": "string" },
        "completedAt": { "type": "string" }
      },
      "required": ["id", "gameType", "userId", "userName", "timeSeconds", "score", "level", "dayDate", "completedAt"]
    },
    "UserGameProfile": {
      "title": "User Game Profile and Streaks",
      "description": "Tracks player daily streaks, solved counts, and best times",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "currentStreak": { "type": "integer" },
        "longestStreak": { "type": "integer" },
        "lastPlayedDate": { "type": "string" },
        "totalGamesSolved": { "type": "integer" },
        "bestSudokuTime": { "type": "integer" },
        "bestWordTime": { "type": "integer" },
        "bestMathTime": { "type": "integer" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "currentStreak", "longestStreak", "lastPlayedDate", "totalGamesSolved"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Top-level collection for user accounts keyed by their Firebase Auth UID"
    },
    "/users/{userId}/game_profile/{profileId}": {
      "schema": "UserGameProfile",
      "description": "Sub-collection for personal game streaks and solver stats"
    },
    "/game_scores/{scoreId}": {
      "schema": "GameScore",
      "description": "Global leaderboard collection for all solvers with time records and ranks"
    },
    "/users/{userId}/resumes/{resumeId}": {
      "schema": "Resume",
      "description": "Sub-collection of resumes belonging to a specific user profile"
    },
    "/users/{userId}/letters/{letterId}": {
      "schema": "CoverLetter",
      "description": "Sub-collection of cover letters belonging to a specific user profile"
    },
    "/users/{userId}/career_recommendations/{recId}": {
      "schema": "CareerRecommendation",
      "description": "Sub-collection for storing user-specific AI career guidance logs and recommendations"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Global collection for user reviews and feedback"
    },
    "/admin_chats/{msgId}": {
      "schema": "AdminChat",
      "description": "Global collection for user-to-admin message history"
    },
    "/direct_messages/{msgId}": {
      "schema": "DirectMessage",
      "description": "Global collection for peer-to-peer user direct messages with optional media attachments"
    }
  }
}
